# Kasera Payment Gateway
# Gunakan kp_test_... untuk mode sandbox/testing, dan kp_live_... untuk mode live/production
KASERA_PAY_KEY=kp_test_
KASERA_PAY_BASE_URL=https://pay.kasera.id/v1
# Diambil dari dashboard Kasera menu Developer -> Webhook (berawalan whsec_...)
KASERA_PAY_WEBHOOK_SECRET=whsec_
# Masa berlaku pembayaran checkout dalam menit (contoh: 60 = 1 jam, 1440 = 24 jam. Min 1, Max 10080)
KASERA_PAY_EXPIRES_IN_MINUTES=60

