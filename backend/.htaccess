# ==============================================================================
# JalurGaib WA Gateway - Root Directory Apache Hardening
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to sensitive files and directories immediately
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml|artisan|storage/logs/.*) - [F,L,NC]

    # 2. Automatically redirect all web traffic into the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to hidden files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory browsing
Options -Indexes
