# Internal API Key (must match Laravel's WA_SERVICE_API_KEY)
INTERNAL_API_KEY=your-super-secret-internal-key-here

# Port for this Go service
PORT=8080

# SQLite database path
DB_PATH=./data/whatsapp.db

# Laravel webhook URL (for inbound messages)
LARAVEL_WEBHOOK_URL=http://localhost/api/webhooks/whatsapp/inbound
